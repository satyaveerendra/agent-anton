# Copy to .env (gitignored). Only `anton discover` needs the API key.
ANTHROPIC_API_KEY=
ANTON_MODEL=claude-sonnet-5
# Origin of the target app; policy.yaml's allowed_origins expands this (default http://localhost:8000).
ANTON_TARGET_ORIGIN=
# FAKE demo credential for the local target app (SPEC §6). SecretRef("DEMO_PASSWORD") resolves to it.
ANTON_SECRET_DEMO_PASSWORD=demo-pass-1
